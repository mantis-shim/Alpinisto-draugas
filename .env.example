# Copy to .env and fill in. Never commit .env (PA-6).

# Set automatically by compose.yaml inside Docker. Only needed when running `npm run dev` on the host.
MONGODB_URI=mongodb://localhost:27017/alpinisto-draugas

# External LLM used for hike recommendations (UC-7)
ANTHROPIC_API_KEY=

# Local llama.cpp server (llama-server, OpenAI-compatible API) used for item recognition from photos (UC-3).
# From inside Docker: http://host.docker.internal:8080   From the host: http://localhost:8080
LLAMA_URL=http://host.docker.internal:8080
