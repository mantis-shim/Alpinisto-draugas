# Copy to .env and fill in. Never commit .env (PA-6).

# Set automatically by compose.yaml inside Docker. Only needed when running `npm run dev` on the host.
MONGODB_URI=mongodb://localhost:27017/alpinisto-draugas

# Google Gemini, used for hike recommendations (UC-7). Get your own key: aistudio.google.com -> Get API key.
GEMINI_API_KEY=
# Gemini model. Empty: gemini-flash-latest (Google's alias for the newest Flash model).
GEMINI_MODEL=
# Canned recommendations instead of Gemini (src/lib/server/gemini/recommendation-format.ts). Empty: use GEMINI_API_KEY.
# One of: ok, unknown-location, error, refusal. Restart the app after changing it.
RECOMMENDATIONS_MOCK=

# llama.cpp server (llama-server, OpenAI-compatible API) used for item recognition from photos (UC-3).
# It runs on a separate team device, e.g. http://192.168.1.50:8080 (llama-server on this machine: http://host.docker.internal:8080)
LLAMA_URL=
# llama-server's --api-key (sent as "Authorization: Bearer ...")
LLAMA_API_KEY=
# Canned recognition replies instead of llama-server (src/lib/server/llama_api/recognition-mocks.ts). Empty: use LLAMA_URL.
# One of: recognized, noAttributes, unknownItem, invalid, timeout, unreachable, flaky.
# Restart the app after changing it.
RECOGNITION_MOCK=

# Production only (adapter-node, default 512K): photo uploads are up to 10 MB plus form overhead (UC-3).
BODY_SIZE_LIMIT=11M
